{
  "name": "tree-sitter-qsharp",
  "version": "0.3.1",
  "description": "Q# grammar for tree-sitter",
  "type": "module",
  "repository": "github:bezpechno/tree-sitter-qsharp",
  "license": "MIT",
  "main": "bindings/node/index.js",
  "types": "bindings/node/index.d.ts",
  "keywords": [
    "tree-sitter",
    "qsharp",
    "q#",
    "quantum",
    "parser"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.27.2"
  },
  "scripts": {
    "install": "node-gyp-build",
    "build": "tree-sitter generate && node-gyp build",
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse",
    "test:node": "node --test bindings/node/*_test.js"
  }
}
